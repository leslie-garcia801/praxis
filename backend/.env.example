DATABASE_URL=postgresql://app:app@localhost:5432/app_dev
BETTER_AUTH_SECRET=            # at least 32 random characters
BETTER_AUTH_URL=http://localhost:5173   # public URL the browser uses (Vercel domain in production)
FRONTEND_ORIGIN=http://localhost:5173
RESEND_API_KEY=
MAIL_FROM=
APP_TIMEZONE=America/Monterrey
PORT=3000
# First administrator (pnpm db:seed); the password must have 12+ characters
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Administrador
# Local demo data (pnpm db:seed:demo): password of every demo user, 12+ characters
SEED_DEMO_PASSWORD=
# RF-28: Web Push (VAPID). Generate with: pnpm exec web-push generate-vapid-keys
# All three or none; push is disabled when missing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vinculacion@tu-dominio.invalid